        "subject": "Daily Matching Job Alert",
        "message": "=<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Job Opportunity Summary</title>\n</head>\n\n<body style=\"margin:0;padding:0;background:#f4f6f9;font-family:Arial,Helvetica,sans-serif;\">\n\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f6f9;padding:30px 0;\">\n<tr>\n<td align=\"center\">\n\n<table width=\"700\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:10px;overflow:hidden;border:1px solid #e5e5e5;\">\n\n    <!-- Header -->\n    <tr>\n        <td style=\"background:#1f4e79;color:#ffffff;padding:25px 35px;\">\n            <h1 style=\"margin:0;font-size:26px;font-weight:bold;\">\n                🚀 New Job Opportunity Found\n            </h1>\n            <p style=\"margin:8px 0 0;font-size:15px;color:#dbe9f6;\">\n                Generated automatically by your recruitment workflow\n            </p>\n        </td>\n    </tr>\n\n    <!-- Job Details -->\n    <tr>\n        <td style=\"padding:35px;\">\n\n            <h2 style=\"margin:0 0 25px;color:#1f4e79;border-bottom:2px solid #eeeeee;padding-bottom:10px;\">\n                Job Information\n            </h2>\n\n            <table width=\"100%\" cellpadding=\"8\" cellspacing=\"0\" style=\"border-collapse:collapse;\">\n\n                <tr>\n                    <td width=\"180\" style=\"font-weight:bold;color:#555555;\">\n                        Job Title\n                    </td>\n                    <td style=\"color:#333333;\">\n                        {{ $json['Title '] }}\n                    </td>\n                </tr>\n\n                <tr style=\"background:#f8f9fb;\">\n                    <td style=\"font-weight:bold;color:#555555;\">\n                        Company\n                    </td>\n                    <td style=\"color:#333333;\">\n                        {{ $json.Company }}\n                    </td>\n                </tr>\n\n                <tr>\n                    <td style=\"font-weight:bold;color:#555555;\">\n                        Location\n                    </td>\n                    <td style=\"color:#333333;\">\n                        {{ $json['Location '] }}\n                    </td>\n                </tr>\n\n                <tr style=\"background:#f8f9fb;\">\n                    <td style=\"font-weight:bold;color:#555555;\">\n                        Match Score\n                    </td>\n                    <td>\n                        <span style=\"display:inline-block;background:#28a745;color:#ffffff;padding:6px 14px;border-radius:20px;font-weight:bold;\">\n                            {{ $json.Score }}\n                        </span>\n                    </td>\n                </tr>\n\n                <tr>\n                    <td style=\"font-weight:bold;color:#555555;\">\n                        Job Link\n                    </td>\n                    <td>\n                        <a href=\"{{ $json.Link }}\"\n                           style=\"color:#0d6efd;text-decoration:none;font-weight:bold;\">\n                            View Job Posting →\n                        </a>\n                    </td>\n                </tr>\n\n            </table>\n\n            <!-- Description -->\n            <div style=\"margin-top:35px;\">\n                <h2 style=\"color:#1f4e79;border-bottom:2px solid #eeeeee;padding-bottom:10px;\">\n                    Job Description\n                </h2>\n\n                <div style=\"background:#f8f9fb;border-left:4px solid #1f4e79;padding:18px;white-space:pre-wrap;line-height:1.7;color:#444444;\">\n{{ $json.Description }}\n                </div>\n            </div>\n\n            <!-- Cover Letter -->\n            <div style=\"margin-top:35px;\">\n                <h2 style=\"color:#1f4e79;border-bottom:2px solid #eeeeee;padding-bottom:10px;\">\n                    AI Generated Cover Letter\n                </h2>\n\n                <div style=\"background:#fff8e6;border-left:4px solid #ff9800;padding:18px;white-space:pre-wrap;line-height:1.8;color:#444444;\">\n{{ $json['Cover Letter'] }}\n                </div>\n            </div>\n\n        </td>\n    </tr>\n\n    <!-- Footer -->\n    <tr>\n        <td style=\"background:#f4f6f9;padding:20px;text-align:center;font-size:13px;color:#777777;\">\n            <strong>Generated Automatically</strong><br>\n            This email was created by your n8n job hunting automation workflow.<br><br>\n\n            <span style=\"color:#999999;\">\n                Happy Job Hunting! 🚀\n            </span>\n        </td>\n    </tr>\n\n</table>\n\n</td>\n</tr>\n</table>\n\n</body>\n</html>",
