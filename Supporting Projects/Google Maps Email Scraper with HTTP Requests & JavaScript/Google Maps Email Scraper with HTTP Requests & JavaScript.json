    {
      "parameters": {
        "jsCode": "// Get existing emails from Google Sheet\nconst existingRows = $('Google Sheets').all();\nconst existingEmails = new Set(\n  existingRows\n    .map(row => row.json.email || row.json.Email || '')\n    .filter(e => e)\n    .map(e => e.toLowerCase().trim())\n);\n\n// Filter current batch — keep only emails not already in sheet\nconst newItems = items.filter(item => {\n  const email = item.json.emails;\n  if (!email) return false;\n  return !existingEmails.has(email.toLowerCase().trim());\n});\n\nreturn newItems.length > 0 ? newItems : [{ json: { skipped: 'all duplicates' } }];"
      },
      "type": "n8n-nodes-base.code",
