      ],
      "typeVersion": 2,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const raw = item.json.website;\n  const clean = raw ? raw.split('?')[0] : null;\n  return {\n    json: {\n      website: clean\n    }\n  };\n}).filter(item => item.json.website !== null);"
      },
