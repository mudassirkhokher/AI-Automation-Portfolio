      "parameters": {
        "jsCode": "const allResults = items.flatMap(item => item.json.local_results || []);\n\nconst seen = new Set();\n\nreturn allResults\n  .filter(result => {\n    if (!result.website || seen.has(result.website)) {\n      return false;\n    }\n    seen.add(result.website);\n    return true;\n  })\n  .map(result => ({\n    json: {\n      name: result.title || null,\n      website: result.website || null,\n      phone: result.phone || null,\n      address: result.address || null,\n      rating: result.rating || null,\n      country: result.country || null,\n    }\n  }));"
      },
