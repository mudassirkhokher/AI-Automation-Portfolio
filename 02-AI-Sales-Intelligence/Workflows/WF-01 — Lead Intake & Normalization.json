      "id": "13d07d46-01d1-414c-895e-e488250b8ebf",
      "name": "Normalize Lead Input Node name"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst seenKeys = new Set();\n\nfunction cleanName(value) {\n  return String(value ?? '')\n    .trim()\n    .replace(/\\s+/g, ' ')\n    .replace(/\\b\\p{L}/gu, char => char.toUpperCase());\n}\n\nfunction normalizeDomain(value) {\n  let domain = String(value ?? '').trim().toLowerCase();\n\n  if (!domain) return '';\n\n  domain = domain.replace(/^[a-z]+:\\/\\//i, '');\n  domain = domain.replace(/^www\\./i, '');\n  domain = domain.split('/')[0];\n  domain = domain.split('?')[0];\n  domain = domain.split('#')[0];\n  domain = domain.replace(/:\\d+$/, '');\n  domain = domain.replace(/\\.+$/, '');\n\n  return domain;\n}\n\nfunction isValidEmail(email) {\n  return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email);\n}\n\nfunction isValidDomain(domain) {\n  return /^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$/i.test(domain);\n}\n\nreturn items.map((item, index) => {\n  const input = item.json;\n\n  const firstName = cleanName(input.first_name);\n  const lastName = cleanName(input.last_name);\n  const email = String(input.email ?? '').trim().toLowerCase();\n  const companyName = String(input.company_name ?? '')\n    .trim()\n    .replace(/\\s+/g, ' ');\n\n  const domain = normalizeDomain(input.company_domain);\n\n  const phone = String(input.phone ?? '')\n    .trim()\n    .replace(/[^\\d+]/g, '');\n\n  const errors = [];\n  const reviewReasons = [];\n\n  // Empty row detection\n  const hasAnyLeadData = [\n    input.first_name,\n    input.last_name,\n    input.email,\n    input.phone,\n    input.job_title,\n    input.company_name,\n    input.company_domain,\n    input.company_country,\n    input.company_city\n  ].some(value => String(value ?? '').trim() !== '');\n\n  if (!hasAnyLeadData) {\n    errors.push('Empty source row');\n  }\n\n  // Required fields\n  if (!firstName) errors.push('Missing first_name');\n  if (!lastName) errors.push('Missing last_name');\n  if (!email) errors.push('Missing email');\n  if (!companyName) errors.push('Missing company_name');\n\n  // Email\n  if (email && !isValidEmail(email)) {\n    errors.push('Invalid email format');\n  }\n\n  // Domain\n  if (domain && !isValidDomain(domain)) {\n    reviewReasons.push('Company domain could not be confidently normalized');\n  }\n\n  // Basic phone validation\n  if (phone && phone.replace(/\\D/g, '').length < 7) {\n    reviewReasons.push('Phone number looks unusually short');\n  }\n\n  // Duplicate preparation\n  const emailNormalized = email;\n  const contactIdentityKey =\n    `${firstName} ${lastName}`.trim().toLowerCase() +\n    '|' +\n    domain;\n\n  const duplicateKey =\n    emailNormalized ||\n    contactIdentityKey;\n\n  if (duplicateKey && seenKeys.has(duplicateKey)) {\n    reviewReasons.push('Duplicate source row detected in current intake batch');\n  }\n\n  if (duplicateKey) {\n    seenKeys.add(duplicateKey);\n  }\n\n  // Determine status\n  let validationStatus = 'VALID';\n\n  if (errors.length > 0) {\n    validationStatus = 'INVALID';\n  } else if (reviewReasons.length > 0) {\n    validationStatus = 'NEEDS_REVIEW';\n  }\n\n  const now = new Date().toISOString();\n\n  const source = 'google_sheets';\n  const sourceRecordId = String(input.source_record_id ?? '');\n\n  const leadId =\n    `${source}_${sourceRecordId}`.toLowerCase();\n\n  return {\n    json: {\n      lead_id: leadId,\n      source,\n      source_record_id: sourceRecordId,\n\n      first_name: firstName,\n      last_name: lastName,\n      full_name: `${firstName} ${lastName}`.trim(),\n\n      email,\n      phone,\n\n      job_title: String(input.job_title ?? '').trim(),\n\n      company_name: companyName,\n      company_domain: domain,\n      company_country: String(input.company_country ?? '').trim(),\n      company_city: String(input.company_city ?? '').trim(),\n\n      lead_source: String(input.lead_source ?? '').trim(),\n\n      consent_status: String(input.consent_status ?? '').trim().toUpperCase(),\n      contact_status: 'NEW',\n\n      created_at: now,\n      updated_at: now,\n\n      processing_status: 'PROCESSED',\n      validation_status: validationStatus,\n\n      validation_errors: [\n        ...errors,\n        ...reviewReasons\n      ],\n\n      email_normalized: emailNormalized,\n      company_domain_normalized: domain,\n      contact_identity_key: contactIdentityKey,\n\n      row_number: input.row_number\n    },\n    pairedItem: index\n  };\n});"
      },
