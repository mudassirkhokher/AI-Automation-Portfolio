    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\n\nitem.json.Status = \"PENDING_SCRAPING\";\nitem.json[\"Research Status\"] = \"QUEUED\";\nitem.json[\"Research Source\"] = \"PHANTOMBUSTER\";\nitem.json[\"Updated At\"] = new Date().toISOString();\n\n// Clear any previous research values\nitem.json[\"Greeting\"] = \"\";\nitem.json[\"Connection Reference\"] = \"\";\nitem.json[\"Personalised Opening\"] = \"\";\nitem.json[\"Company Summary\"] = \"\";\nitem.json[\"Research Confidence\"] = \"\";\nitem.json[\"AI Confidence\"] = \"\";\nitem.json[\"AI Fallback\"] = \"\";\nitem.json[\"Container ID\"] = \"\";\nitem.json[\"Launch Start At\"] = \"\";\n\nreturn item;"
      },
      "type": "n8n-nodes-base.code",
