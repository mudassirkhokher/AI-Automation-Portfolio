    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $json.phantomStatus;\n\nlet internal=\"UNKNOWN\";\n\nlet connectionSent=false;\nlet connected=false;\nlet firstSent=false;\nlet followupSent=false;\nlet replied=false;\n\nswitch(p){\n\ncase \"Not invited yet\":\ninternal=\"READY_TO_CONNECT\";\nbreak;\n\ncase \"Invitation sent\":\ncase \"Invited\":\n\ninternal=\"CONNECTION_SENT\";\nconnectionSent=true;\nbreak;\n\ncase \"Already connected\":\ncase \"Request accepted\":\ncase \"Accepted\":\n\ninternal=\"CONNECTED\";\nconnectionSent=true;\nconnected=true;\nbreak;\n\ncase \"1st follow-up sent\":\ncase \"Follow-up sent\":\n\ninternal=\"FOLLOWUP_SENT\";\nconnectionSent=true;\nconnected=true;\nfirstSent=true;\nfollowupSent=true;\nbreak;\n\ncase \"Replied\":\ncase \"Replied (Connection request)\":\n\ninternal=\"REPLIED\";\nconnectionSent=true;\nconnected=true;\nreplied=true;\nbreak;\n\ncase \"Couldn't invite\":\ncase \"Could not invite\":\n\ninternal=\"FAILED\";\nbreak;\n\n}\n\n$json.internalStatus=internal;\n\n$json.connectionSent=connectionSent;\n$json.connected=connected;\n$json.firstMessageSent=firstSent;\n$json.followupSent=followupSent;\n$json.replyReceived=replied;\n\nreturn {\n  json: $json\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "id": "971cecfc-ad77-4856-9bc4-8949f317d613",
