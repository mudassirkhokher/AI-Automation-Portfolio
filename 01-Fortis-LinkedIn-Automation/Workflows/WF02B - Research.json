    {
      "parameters": {
        "jsCode": "const p = $json;\n\nreturn [{\n  json: {\n    // ============================================================\n    // ORIGINAL QUEUE INFORMATION\n    // ============================================================\n\n    \"Queue ID\": p[\"Queue ID\"],\n    \"Lead ID\": p[\"Lead ID\"],\n\n    \"First Name\": p[\"First Name\"],\n    \"Last Name\": p[\"Last Name\"],\n\n    \"LinkedIn URL\": p[\"LinkedIn URL\"],\n\n    \"Job Title\": p[\"Job Title\"],\n    \"Seniority\": p[\"Seniority\"],\n\n    \"Company Name\": p[\"Company Name\"],\n    \"Company Website\": p[\"Company Website\"],\n\n    \"Industry\": p[\"Industry\"],\n    \"Country\": p[\"Country\"],\n    \"City\": p[\"City\"],\n    \"Company Size\": p[\"Company Size\"],\n\n    // ============================================================\n    // PHANTOMBUSTER RESEARCH\n    // ============================================================\n\n    Headline: p.linkedinHeadline || \"\",\n\n    About: p.linkedinDescription || \"\",\n\n    Skills: p.linkedinSkillsLabel || \"\",\n\n    CurrentRole: p.linkedinJobTitle || \"\",\n\n    // ----------------------------\n    // FIX #1\n    // ----------------------------\n    CurrentCompany:\n      p.companyName ||\n      p[\"Company Name\"] ||\n      \"\",\n\n    CompanySummary: p.linkedinCompanyDescription || \"\",\n\n    // ----------------------------\n    // FIX #2\n    // ----------------------------\n    CompanyIndustry:\n      p.companyIndustry ||\n      p[\"Industry\"] ||\n      \"\",\n\n    // ----------------------------\n    // FIX #3\n    // ----------------------------\n    CompanyWebsite:\n      p.companyWebsite ||\n      p[\"Company Website\"] ||\n      \"\",\n\n    CompanySize: p.linkedinCompanySize || \"\",\n\n    CompanyFollowers: p.linkedinCompanyFollowerCount || 0,\n\n    Followers: p.linkedinFollowersCount || 0,\n\n    Location: p.location || \"\",\n\n    ProfileURL: p.linkedinProfileUrl || \"\",\n\n    ConnectionDegree: p.connectionDegree || \"\",\n\n    // ============================================================\n    // OPTIONAL PROFILE DETAILS\n    // ============================================================\n\n    OpenToWork: p.linkedinIsOpenToWorkBadge || false,\n\n    HiringBadge: p.linkedinIsHiringBadge || false,\n\n    CurrentJobDate: p.linkedinJobDateRange || \"\",\n\n    PreviousRole: p.linkedinPreviousJobTitle || \"\",\n\n    PreviousCompany: p.previousCompanyName || \"\",\n\n    PreviousJobDate: p.linkedinPreviousJobDateRange || \"\",\n\n    Education: p.linkedinSchoolName || \"\",\n\n    Degree: p.linkedinSchoolDegree || \"\",\n\n    FieldOfStudy: p.linkedinSchoolFieldOfStudy || \"\",\n\n    CompanyFounded: p.linkedinCompanyFounded || \"\",\n\n    CompanyEmployees: p.linkedinCompanyEmployeesCount || \"\",\n\n    CompanyHQ: p.linkedinCompanyHeadquarter || \"\",\n\n    CompanyTagline: p.linkedinCompanyTagline || \"\",\n\n    CompanySpecialities: p.linkedinCompanySpecialities || \"\",\n\n    // ============================================================\n    // WORKFLOW METADATA\n    // ============================================================\n\n    ResearchSource: \"Phantombuster\",\n\n    ResearchConfidence: 100,\n\n    researchCompleted: true\n  }\n}];"
      },
