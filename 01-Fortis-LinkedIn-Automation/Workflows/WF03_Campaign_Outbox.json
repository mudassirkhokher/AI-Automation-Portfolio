    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "71c6e594-6d0e-4db8-bb3d-f95d1f8eaff7",
              "name": "ConnectionMessage",
              "value": "={{ $json[\"Greeting\"] }}\n\n{{ $json[\"Connection Reference\"] }} Ich würde mich freuen, mich mit Ihnen zu vernetzen.\n\nBeste Grüße\nNatalie Afchar",
              "type": "string"
            },
            {
              "id": "e03ca689-ef97-44ba-9876-2ac2c6478c9b",
              "name": "=FirstMessage",
              "value": "={{ $json[\"Greeting\"] }}\n\nvielen Dank, dass Sie meine Kontaktanfrage angenommen haben.\n\n{{ $json[\"Personalised Opening\"] }}\n\nAls Teamleiterin bei Fortis Inkasso unterstütze ich Unternehmen dabei, offene Forderungen professionell einzuziehen – sowohl bei einzelnen unbezahlten Rechnungen als auch bei größeren Forderungsbeständen. Dabei gehen wir konsequent vor und achten zugleich auf einen angemessenen Umgang mit den jeweiligen Kunden.\n\nFalls das Thema bei {{ $json[\"Company Name\"] }} aktuell oder künftig relevant ist, können wir gern unverbindlich besprechen, wie wir Sie entlasten können.\n\nFür die außergerichtliche Beitreibung fallen für Sie als Gläubiger keine Vorkosten oder festen Bearbeitungsgebühren an.\n\nEinen kurzen Gesprächstermin können Sie hier auswählen:\nhttps://calendly.com/fortis-inkasso\n\nEine konkrete Forderung können Sie direkt über unser Dashboard einreichen:\nhttps://fortis-portal.de/\n\nWeitere Informationen zu Fortis Inkasso finden Sie hier:\nhttps://fortis-inkasso.de/\n\nSie können mir auch direkt auf LinkedIn antworten oder uns über WhatsApp unter +49 157 83989618 schreiben.\n\nBeste Grüße\n\nNatalie Afchar  \nTeamleitung Fortis Inkasso",
              "type": "string"
            },
            {
              "id": "05acf401-8451-411e-beb0-e255ca4c8ea8",
              "name": "FollowupMessage",
              "value": "={{ $json[\"Greeting\"] }}\n\nich wollte mich noch einmal kurz bei Ihnen melden.\n\nVielleicht ist das Thema offene Forderungen bei {{ $json[\"Company Name\"] }} derzeit nicht akut. Dann behalten Sie meine Kontaktdaten gern für den Fall, dass künftig eine Rechnung offenbleibt.\n\nEine Forderung können Sie jederzeit direkt über unser Dashboard einreichen:\nhttps://fortis-portal.de/\n\nWenn Sie vorab kurz und unverbindlich sprechen möchten, können Sie mir direkt antworten oder hier einen Termin auswählen:\nhttps://calendly.com/fortis-inkasso\n\nAlternativ erreichen Sie uns auch über WhatsApp unter +49 157 83989618.\n\nBeste Grüße\n\nNatalie Afchar  \nTeamleitung Fortis Inkasso",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "include": "selected",
        "includeFields": "['Queue ID'], ['First Name'], ['Last Name'], ['LinkedIn URL'], ['Job Title'], ['Company Name']",
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -480,
        -768
      ],
      "id": "e3e697f8-e1ff-42f2-9b8c-75011df361f5",
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const fallbackConnection = `${$json[\"Greeting\"]}\n\nIch bin auf ${$json[\"Company Name\"]} aufmerksam geworden und würde mich freuen, mich mit Ihnen zu vernetzen.\n\nBeste Grüße\nNatalie Afchar`;\n\n// Ensure ConnectionMessage always exists\n$json.ConnectionMessage = $json.ConnectionMessage || \"\";\n\n// Calculate message length\n$json.ConnectionLength = $json.ConnectionMessage.length;\n\n// Apply fallback if LinkedIn limit is exceeded\nif ($json.ConnectionLength > 300) {\n\n    $json.ConnectionMessage = fallbackConnection;\n\n    $json.ConnectionLength = fallbackConnection.length;\n\n    $json[\"AI Fallback\"] = true;\n\n    $json[\"Fallback Reason\"] =\n        \"Personalised connection request exceeded LinkedIn's 300-character limit.\";\n\n} else {\n\n    $json[\"AI Fallback\"] = false;\n\n    $json[\"Fallback Reason\"] = \"\";\n\n}\n\n// Return the updated item\nreturn {\n    json: $json\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -256,
        -768
      ],
      "id": "4ff9c026-cf8f-4bf8-a8aa-7c088a23b976",
      "name": "Connection Length Check"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const errors = [];\n\n// Required messages\nif (!$json.ConnectionMessage?.trim())\n    errors.push(\"Missing ConnectionMessage\");\n\nif (!$json.FirstMessage?.trim())\n    errors.push(\"Missing FirstMessage\");\n\nif (!$json.FollowupMessage?.trim())\n    errors.push(\"Missing FollowupMessage\");\n\n// Undefined / placeholder checks\n[\n    \"ConnectionMessage\",\n    \"FirstMessage\",\n    \"FollowupMessage\"\n].forEach(field => {\n\n    const value = String($json[field] ?? \"\");\n\n    if (value.includes(\"undefined\"))\n        errors.push(`${field} contains undefined`);\n\n    if (value.includes(\"null\"))\n        errors.push(`${field} contains null`);\n\n    if (value.includes(\"{{\"))\n        errors.push(`${field} contains unresolved variable`);\n});\n\n// LinkedIn character limit\nif (($json.ConnectionLength ?? 999) > 300)\n    errors.push(\"Connection message exceeds 300 characters\");\n\n// Greeting check\nif (!$json.ConnectionMessage?.startsWith(\"Guten Tag\"))\n    errors.push(\"Greeting missing\");\n\n// Final status\nif (errors.length > 0) {\n\n    $json.Status = \"MESSAGE_ERROR\";\n    $json.Errors = errors.join(\" | \");\n\n} else {\n\n    $json.Status = \"READY_TO_REVIEW\";\n    $json.Errors = \"\";\n\n}\n\n// Return updated item\nreturn {\n    json: $json\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
